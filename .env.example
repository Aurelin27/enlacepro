# Copia este archivo como .env y completa los valores.
# NUNCA subas el archivo .env a un repositorio público.

# Base de datos PostgreSQL
DATABASE_URL=postgres://usuario:password@localhost:5432/enlacepro

# Secreto para las sesiones (texto largo y aleatorio)
SESSION_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# URL pública de la aplicación (para las redirecciones de Stripe)
APP_URL=http://localhost:3000

# Puerto (Render lo asigna automáticamente)
PORT=3000

# Stripe — modo de prueba: las claves empiezan con pk_test / sk_test
# Se obtienen en https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Secreto del webhook de Stripe (se obtiene al crear el endpoint webhook)
STRIPE_WEBHOOK_SECRET=

# IDs de los precios creados en el panel de Stripe (https://dashboard.stripe.com/test/products)
# Básico: $10/mes y $90/año | VIP: $20/mes y $180/año
STRIPE_PRICE_BASICO_MONTHLY=
STRIPE_PRICE_BASICO_YEARLY=
STRIPE_PRICE_VIP_MONTHLY=
STRIPE_PRICE_VIP_YEARLY=
