<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title><%= title %> · EnlacePro</title>
<link rel="stylesheet" href="/styles.css"/>
</head>
<body class="public-page style-<%= style %>">
  <div class="public-content">
    <% if (profileUser.photo_url) { %>
      <img class="public-avatar-img" src="<%= profileUser.photo_url %>" alt="Foto de <%= profileUser.name || profileUser.slug %>"/>
    <% } else { %>
      <div class="public-avatar"><%= ((profileUser.name || profileUser.slug || 'E').charAt(0)).toUpperCase() %></div>
    <% } %>
    <h1><%= profileUser.name || '@' + profileUser.slug %></h1>
    <% if (profileUser.bio) { %><p><%= profileUser.bio %></p><% } %>
    <div class="public-links">
      <% links.forEach(function(l){ %>
        <a class="public-link" href="<%= l.url %>" target="_blank" rel="noopener noreferrer"><span><%= l.title %></span><span>↗</span></a>
      <% }); %>
    </div>
    <% if (!links.length) { %><p class="empty-links">Esta página aún no tiene enlaces.</p><% } %>
    <div class="public-brand">Hecho con <a href="/">EnlacePro</a> ✦</div>
  </div>
</body>
</html>
