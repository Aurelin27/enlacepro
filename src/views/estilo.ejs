<%- include('partials/head') %>
<div class="wrap dashboard">
  <div class="dash-head"><div><h1>Estilo visual</h1><p>Elige cómo se ve tu página pública.</p></div></div>
  <form action="/dashboard/estilo" method="post">
    <div class="style-grid">
      <% [1,2,3,4].forEach(function(s){ 
           var names = {1:'Noche', 2:'Claro', 3:'Violeta', 4:'Océano'};
           var locked = (s === 3 || s === 4) && !vip;
      %>
        <label class="style-card style-<%= s %> <%= user.style === s ? 'selected' : '' %> <%= locked ? 'locked' : '' %>">
          <input type="radio" name="style" value="<%= s %>" <%= user.style === s ? 'checked' : '' %> <%= locked ? 'disabled' : '' %>/>
          <div class="style-mock"><span class="mock-avatar"></span><span class="mock-line"></span><span class="mock-line"></span></div>
          <div class="style-name"><%= names[s] %> <% if (locked) { %><span class="vip-badge">VIP</span><% } %></div>
        </label>
      <% }); %>
    </div>
    <div class="savebar">
      <button class="btn btn-primary" type="submit">Guardar estilo</button>
      <a class="btn btn-ghost" href="/dashboard">Volver</a>
      <% if (!vip) { %><a class="btn btn-outline" href="/planes">Ver plan VIP →</a><% } %>
    </div>
  </form>
</div>
<%- include('partials/footer') %>
