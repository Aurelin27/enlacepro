<%- include('../partials/head') %>
<div class="wrap dashboard">
  <div class="dash-head"><div><h1>Usuarios</h1><p><%= users.length %> cuentas registradas.</p></div></div>
  <div class="dash-card">
    <table class="table">
      <thead><tr><th>Correo</th><th>Nombre</th><th>Enlace</th><th>Rol</th><th>Plan</th><th>Estado</th><th>Puntos</th><th>Cambiar plan</th></tr></thead>
      <tbody>
        <% users.forEach(function(u){ %>
          <tr>
            <td><%= u.email %></td>
            <td><%= u.name || '—' %></td>
            <td><a href="/<%= u.slug %>" target="_blank" rel="noopener">/<%= u.slug %> ↗</a></td>
            <td><%= u.role === 'admin' ? '<strong>admin</strong>' : 'usuario' %></td>
            <td><%= u.plan === 'none' ? '—' : u.plan + (u.billing_interval ? ' (' + (u.billing_interval === 'yearly' ? 'anual' : 'mensual') + ')' : '') %></td>
            <td><%= u.subscription_status %></td>
            <td><%= u.points %></td>
            <td>
              <form action="/admin/usuarios/<%= u.id %>/plan" method="post" class="inline-form">
                <select name="plan">
                  <option value="none" <%= u.plan === 'none' ? 'selected' : '' %>>Sin plan</option>
                  <option value="basico" <%= u.plan === 'basico' ? 'selected' : '' %>>Básico</option>
                  <option value="vip" <%= u.plan === 'vip' ? 'selected' : '' %>>VIP</option>
                </select>
                <button class="btn btn-small btn-ghost" type="submit">Aplicar</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
    <div class="savebar"><a class="btn btn-ghost" href="/admin">Volver al panel</a></div>
  </div>
</div>
<%- include('../partials/footer') %>
