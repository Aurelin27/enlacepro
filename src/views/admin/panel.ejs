<%- include('../partials/head') %>
<div class="wrap dashboard">
  <div class="dash-head"><div><h1>Administración</h1><p>Resumen de tu aplicación.</p></div></div>

  <div class="stat-cards">
    <div class="stat-card"><span class="stat-num"><%= totalUsers %></span><span class="stat-label">Usuarios totales</span></div>
    <div class="stat-card"><span class="stat-num"><%= activeSubs %></span><span class="stat-label">Suscripciones activas</span></div>
    <div class="stat-card"><span class="stat-num">$<%= revenue.toFixed(0) %></span><span class="stat-label">Ingreso mensual aprox. (USD)</span></div>
    <div class="stat-card"><span class="stat-num"><%= pendingRequests %></span><span class="stat-label">Solicitudes de referido</span></div>
  </div>

  <div class="dash-grid">
    <a class="dash-card link-card" href="/admin/usuarios"><h2>👥 Usuarios</h2><p>Ver y gestionar planes.</p></a>
    <a class="dash-card link-card" href="/admin/referidos"><h2>🤝 Referidos</h2><p>Aprobar códigos y ver puntos.<% if (pendingRequests) { %> <strong>(<%= pendingRequests %> pendientes)</strong><% } %></p></a>
    <a class="dash-card link-card" href="/admin/ajustes"><h2>⚙ Ajustes</h2><p>Puntos por referido y más.</p></a>
  </div>

  <div class="dash-card">
    <h2>Usuarios recientes</h2>
    <table class="table">
      <thead><tr><th>Correo</th><th>Enlace</th><th>Plan</th><th>Estado</th><th>Registro</th></tr></thead>
      <tbody>
        <% recent.forEach(function(u){ %>
          <tr>
            <td><%= u.email %></td>
            <td><a href="/<%= u.slug %>" target="_blank" rel="noopener">/<%= u.slug %> ↗</a></td>
            <td><%= u.plan === 'none' ? '—' : u.plan %></td>
            <td><%= u.subscription_status %></td>
            <td><%= new Date(u.created_at).toLocaleDateString('es-419') %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/footer') %>
