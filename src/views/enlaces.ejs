<%- include('partials/head') %>
<div class="wrap dashboard">
  <div class="dash-head"><div><h1>Mis enlaces</h1><p>Agrega, edita y ordena los enlaces de tu página.</p></div></div>

  <div class="dash-card" style="margin-bottom:22px">
    <h2>Agregar enlace</h2>
    <form action="/dashboard/enlaces" method="post" class="link-add-form">
      <div class="field"><label for="title">Título</label><input id="title" name="title" type="text" maxlength="80" required placeholder="Mi Instagram"/></div>
      <div class="field"><label for="url">Dirección</label><input id="url" name="url" type="text" maxlength="500" required placeholder="https://instagram.com/..."/></div>
      <div><button class="btn btn-primary" type="submit">Agregar</button></div>
    </form>
  </div>

  <div class="dash-card">
    <h2>Tus enlaces (<%= links.length %>)</h2>
    <% if (!links.length) { %><p class="dash-subtitle">Aún no tienes enlaces. Agrega el primero arriba ☝️</p><% } %>
    <% links.forEach(function(l, i){ %>
      <div class="link-row">
        <div class="link-row-main">
          <strong><%= l.title %></strong>
          <a href="<%= l.url %>" target="_blank" rel="noopener" class="muted-link"><%= l.url.length > 50 ? l.url.slice(0,50) + '…' : l.url %> ↗</a>
        </div>
        <div class="link-row-actions">
          <% if (i > 0) { %><form action="/dashboard/enlaces/<%= l.id %>/subir" method="post" class="inline-form"><button class="btn btn-small btn-ghost" title="Subir">↑</button></form><% } %>
          <% if (i < links.length - 1) { %><form action="/dashboard/enlaces/<%= l.id %>/bajar" method="post" class="inline-form"><button class="btn btn-small btn-ghost" title="Bajar">↓</button></form><% } %>
          <form action="/dashboard/enlaces/<%= l.id %>/eliminar" method="post" class="inline-form" onsubmit="return confirm('¿Eliminar este enlace?')"><button class="btn btn-small btn-danger" type="submit">Eliminar</button></form>
        </div>
      </div>
      <details class="link-edit">
        <summary>Editar</summary>
        <form action="/dashboard/enlaces/<%= l.id %>/editar" method="post" class="link-add-form">
          <div class="field"><label>Título</label><input name="title" type="text" maxlength="80" required value="<%= l.title %>"/></div>
          <div class="field"><label>Dirección</label><input name="url" type="text" maxlength="500" required value="<%= l.url %>"/></div>
          <div><button class="btn btn-small btn-primary" type="submit">Guardar</button></div>
        </form>
      </details>
    <% }); %>
    <div class="savebar"><a class="btn btn-ghost" href="/dashboard">Volver</a></div>
  </div>
</div>
<%- include('partials/footer') %>
