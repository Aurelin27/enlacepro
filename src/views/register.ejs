<%- include('partials/head') %>
<div class="auth-layout">
  <div class="auth-card">
    <a class="brand" href="/"><span class="brand-icon">↗</span> enlace<span class="accent">pro</span></a>
    <h1>Crear cuenta</h1>
    <p>Tu página de enlaces en menos de un minuto.</p>
    <% if (refCode) { %>
      <div class="success">Llegaste con un código de referido. ¡Gana puntos con los referidos!</div>
    <% } %>
    <form class="auth-form" action="/register" method="post">
      <div class="field">
        <label for="name">Tu nombre</label>
        <input id="name" name="name" type="text" maxlength="80" placeholder="Ej. María Creativa" autocomplete="name"/>
      </div>
      <div class="field">
        <label for="email">Correo electrónico</label>
        <input id="email" name="email" type="email" required autocomplete="email"/>
      </div>
      <div class="field">
        <label for="password">Contraseña</label>
        <input id="password" name="password" type="password" required minlength="6" autocomplete="new-password"/>
        <small>Mínimo 6 caracteres.</small>
      </div>
      <div class="field">
        <label for="slug">Nombre de tu enlace</label>
        <div class="slug-input"><span>enlacepro.com/</span><input id="slug" name="slug" type="text" required pattern="[a-z0-9][a-z0-9-]{1,28}[a-z0-9]" placeholder="tunombre"/></div>
        <small>Solo letras minúsculas, números y guiones.</small>
      </div>
      <button class="btn btn-primary" type="submit">Crear mi página →</button>
    </form>
    <p class="auth-switch">¿Ya tienes cuenta? <a href="/login">Inicia sesión</a></p>
  </div>
</div>
<%- include('partials/footer') %>
